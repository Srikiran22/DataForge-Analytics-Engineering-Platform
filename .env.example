# Copy to .env and adjust. NEVER commit real .env values.

# Postgres OLTP source (docker-compose service)
SOURCE_PG_HOST=localhost
SOURCE_PG_PORT=5433
SOURCE_PG_DB=sourcedb
SOURCE_PG_USER=source_reader
SOURCE_PG_PASSWORD=change_me_source

# Admin role used only by seeding/DDL scripts (least-privilege reader used at runtime)
SOURCE_PG_ADMIN_USER=source_admin
SOURCE_PG_ADMIN_PASSWORD=change_me_admin

# DuckDB warehouse file location
WAREHOUSE_PATH=data/warehouse/analytics.duckdb

# Products mock API base URL (Compose service name in Docker, localhost otherwise)
PRODUCTS_API_URL=http://localhost:8100
